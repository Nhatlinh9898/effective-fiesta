{
  "fullstack_react_fastapi": {
    "name": "React + FastAPI + Postgres",
    "description": "Full-stack web app with React frontend, FastAPI backend, and Postgres",
    "stack": {
      "frontend": {"framework": "React", "language": "TypeScript"},
      "backend": {"framework": "FastAPI", "language": "Python"},
      "database": "PostgreSQL"
    },
    "structure": {
      "frontend/": ["src/", "components/", "pages/", "hooks/", "api/", "styles/"],
      "backend/": ["app/", "api/", "models/", "schemas/", "services/", "db/"],
      "infra/": ["docker-compose.yml"]
    },
    "dependencies": {
      "frontend": ["react", "vite", "typescript", "axios", "tailwindcss"],
      "backend": ["fastapi", "uvicorn", "sqlalchemy", "psycopg2-binary", "pydantic"]
    }
  },
  "fullstack_next_nest": {
    "name": "Next.js + NestJS + Postgres",
    "description": "SSR web app with Next.js frontend and NestJS backend",
    "stack": {
      "frontend": {"framework": "Next.js", "language": "TypeScript"},
      "backend": {"framework": "NestJS", "language": "TypeScript"},
      "database": "PostgreSQL"
    },
    "structure": {
      "frontend/": ["src/app/", "src/components/", "src/lib/", "public/"],
      "backend/": ["src/", "src/modules/", "src/common/"],
      "infra/": ["docker-compose.yml"]
    },
    "dependencies": {
      "frontend": ["next", "react", "typescript", "tailwindcss"],
      "backend": ["@nestjs/core", "@nestjs/common", "@nestjs/typeorm", "typeorm"]
    }
  },
  "fullstack_vue_fastapi": {
    "name": "Vue + FastAPI + MongoDB",
    "description": "SPA with Vue frontend, FastAPI backend, and MongoDB",
    "stack": {
      "frontend": {"framework": "Vue", "language": "TypeScript"},
      "backend": {"framework": "FastAPI", "language": "Python"},
      "database": "MongoDB"
    },
    "structure": {
      "frontend/": ["src/", "components/", "views/", "router/", "store/"],
      "backend/": ["app/", "api/", "models/", "schemas/", "services/"],
      "infra/": ["docker-compose.yml"]
    },
    "dependencies": {
      "frontend": ["vue", "vite", "typescript", "pinia", "axios"],
      "backend": ["fastapi", "uvicorn", "motor", "pydantic"]
    }
  },
  "fullstack_svelte_go": {
    "name": "SvelteKit + Go Fiber + Postgres",
    "description": "Modern UI with SvelteKit and Go backend using Fiber",
    "stack": {
      "frontend": {"framework": "SvelteKit", "language": "TypeScript"},
      "backend": {"framework": "Fiber", "language": "Go"},
      "database": "PostgreSQL"
    },
    "structure": {
      "frontend/": ["src/", "src/routes/", "src/lib/"],
      "backend/": ["cmd/", "internal/", "pkg/"],
      "infra/": ["docker-compose.yml"]
    },
    "dependencies": {
      "frontend": ["svelte", "@sveltejs/kit", "typescript"],
      "backend": ["github.com/gofiber/fiber/v2", "github.com/jackc/pgx/v5"]
    }
  },
  "fullstack_flutter_fastapi": {
    "name": "Flutter + FastAPI + Postgres",
