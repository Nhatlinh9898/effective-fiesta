  },
  "fullstack_react_node": {
    "name": "React + Node.js + MongoDB",
    "description": "Classic MERN-style stack",
    "stack": {
      "frontend": {"framework": "React", "language": "TypeScript"},
      "backend": {"framework": "Express", "language": "TypeScript"},
      "database": "MongoDB"
    },
    "structure": {
      "frontend/": ["src/", "components/", "pages/", "api/"],
      "backend/": ["src/", "routes/", "controllers/", "models/", "middleware/"],
      "infra/": ["docker-compose.yml"]
    },
    "dependencies": {
      "frontend": ["react", "vite", "typescript", "axios"],
      "backend": ["express", "mongoose", "jsonwebtoken", "bcrypt", "dotenv"]
    }
  },
  "ui_react_admin_dashboard": {
    "name": "React Admin Dashboard",
    "description": "Admin dashboard UI with analytics, users, and settings",
    "stack": {"frontend": {"framework": "React", "language": "TypeScript"}},
